msgid "plugins.generic.reviewArchive.displayName"
msgstr "Review Archive & Gambling-Spam Check"

msgid "plugins.generic.reviewArchive.description"
msgstr "Adds a \"Review Archive\" tab to the submission workflow for review files that are not shown after a Native XML import, and checks Native XML files for online-gambling spam before they are imported."

msgid "plugins.generic.reviewArchive.tabTitle"
msgstr "Review Archive"

msgid "plugins.generic.reviewArchive.marked.title"
msgstr "Review Files"

msgid "plugins.generic.reviewArchive.marked.description"
msgstr "Files whose name contains {$marker}. They also remain visible in the Submission tab."

msgid "plugins.generic.reviewArchive.marked.empty"
msgstr "No files marked as review files."

msgid "plugins.generic.reviewArchive.hidden.title"
msgstr "Other Review-Stage Files & Attachments"

msgid "plugins.generic.reviewArchive.hidden.description"
msgstr "Review-stage files, attachments and discussion files of this submission. After a Native XML import these are usually not shown, because review rounds, reviewer assignments and discussions are not imported."

msgid "plugins.generic.reviewArchive.hidden.empty"
msgstr "No other files."

