msgstr "Tindakan"

msgid "plugins.generic.reviewArchive.plan.column.stage"
msgstr "Tahap"

msgid "plugins.generic.reviewArchive.plan.action.label"
msgstr "Label"

msgid "plugins.generic.reviewArchive.plan.action.remove"
msgstr "Dibuang"

msgid "plugins.generic.reviewArchive.plan.action.keep"
msgstr "Tetap"

msgid "plugins.generic.reviewArchive.plan.action.galley"
msgstr "Galley"

msgid "plugins.generic.reviewArchive.plan.reason.duplicate"
msgstr "isi sama dengan berkas lain"

msgid "plugins.generic.reviewArchive.plan.reason.production"
msgstr "dokumen kerja produksi"

msgid "plugins.generic.reviewArchive.plan.revisionsRemoved"
msgstr "{$count} dari {$total} revisi dibuang (duplikat/lama)"

msgid "plugins.generic.reviewArchive.results.success"
msgstr "Impor berhasil."

msgid "plugins.generic.reviewArchive.results.successHelp"
msgstr "Berkas review dapat dilihat di tab Arsip Review pada alur kerja artikel."

msgid "plugins.generic.reviewArchive.results.failed"
msgstr "Impor gagal. Tidak ada data yang disimpan."
